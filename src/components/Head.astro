---
// Componente Head - Diseño limpio y moderno con Glassmorphism
export interface Props {
    title?: string;
    titleSeo?: string;
    descripcionSeo?: string;
    url?: string;
    image?: string;
}
const {
    title = "Rolaps | Desarrollo Web Seguro, Optimización y Protección de Sitios",
    titleSeo = "Rolaps | Desarrollo Web Seguro, Optimización y Protección de Sitios",
    descripcionSeo = "En Rolaps desarrollamos sitios web seguros y optimizados, protegemos tu infraestructura digital y mejoramos el rendimiento de tu negocio online. Solicita tu auditoría hoy.",
    url = "https://www.rolaps.com",
    image = "/favicon.png",
} = Astro.props;
const baseUrl = Astro.site || Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl);
---

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={descripcionSeo} />
    <meta name="title" content={title} />
    <link rel="canonical" href={canonicalUrl.toString()} />

    <!-- Open Graph (para compartir en redes sociales) -->
    <meta property="og:title" content={titleSeo} />
    <meta property="og:description" content={descripcionSeo} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(image, baseUrl)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleSeo} />
    <meta name="twitter:description" content={descripcionSeo} />
    <meta name="twitter:image" content={new URL(image, baseUrl)} />

    <!-- Google Search Console (verificación) -->
    <meta name="google-site-verification" content="TU_CODIGO_VERIFICACION" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
    <script
        is:inline
        src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
    ></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet"
    />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet"
    />
    <script id="tailwind-config" is:inline>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-primary": "#003907",
                        "on-primary-container": "#007117",
                        "surface-container-low": "#151b2d",
                        "secondary-container": "#3f465c",
                        "surface-variant": "#2e3447",
                        "on-secondary": "#283044",
                        "tertiary-container": "#b7e3ff",
                        "on-tertiary-fixed": "#001e2c",
                        "surface-tint": "#00e639",
                        "surface-bright": "#33394c",
                        "on-error-container": "#ffdad6",
                        surface: "#0c1324",
                        "inverse-surface": "#dce1fb",
                        background: "#0c1324",
                        "error-container": "#93000a",
                        "surface-dim": "#0c1324",
                        "primary-container": "#00ff41",
                        "on-error": "#690005",
                        "on-secondary-container": "#adb4ce",
                        "secondary-fixed": "#dae2fd",
                        outline: "#84967e",
                        "secondary-fixed-dim": "#bec6e0",
                        secondary: "#bec6e0",
                        primary: "#ebffe2",
                        "surface-container-lowest": "#070d1f",
                        "primary-fixed-dim": "#00e639",
                        "on-primary-fixed": "#002203",
                        "tertiary-fixed-dim": "#7bd0ff",
                        "inverse-on-surface": "#2a3043",
                        "inverse-primary": "#006e16",
                        "on-secondary-fixed-variant": "#3f465c",
                        "on-tertiary": "#00354a",
                        error: "#ffb4ab",
                        "on-background": "#dce1fb",
                        "on-surface-variant": "#b9ccb2",
                        "on-tertiary-container": "#00688e",
                        "surface-container": "#191f31",
                        "outline-variant": "#3b4b37",
                        tertiary: "#f5faff",
                        "surface-container-high": "#23293c",
                        "primary-fixed": "#72ff70",
                        "on-primary-fixed-variant": "#00530e",
                        "on-secondary-fixed": "#131b2e",
                        "tertiary-fixed": "#c4e7ff",
                        "surface-container-highest": "#2e3447",
                        "on-tertiary-fixed-variant": "#004c69",
                        "on-surface": "#dce1fb",
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.5rem",
                        full: "0.75rem",
                    },
                    fontFamily: {
                        headline: ["Space Grotesk"],
                        body: ["Inter"],
                        label: ["Inter"],
                    },
                },
            },
        };
    </script>
    <style>
        body {
            font-family: "Inter", sans-serif;
            background-color: #0c1324;
            color: #dce1fb;
        }
        h1,
        h2,
        h3,
        h4 {
            font-family: "Space Grotesk", sans-serif;
        }
        .material-symbols-outlined {
            font-variation-settings:
                "FILL" 0,
                "wght" 400,
                "GRAD" 0,
                "opsz" 24;
        }
        .glass-panel {
            background: rgba(46, 52, 71, 0.6);
            backdrop-filter: blur(20px);
        }
        .glow-primary:hover {
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.4);
        }
    </style>
    <!-- Google Tag Manager -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({
                "gtm.start": new Date().getTime(),
                event: "gtm.js",
            });
            var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", "GTM-MQDKW8WR");
    </script>
    <!-- End Google Tag Manager -->
    <!-- Google Tag Manager (noscript) -->
    <noscript
        ><iframe
            src="https://www.googletagmanager.com/ns.html?id=GTM-MQDKW8WR"
            height="0"
            width="0"
            style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
</head>
