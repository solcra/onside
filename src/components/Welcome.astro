					class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-transparent to-transparent"
				>
				</div>
			</div>
			<div class="space-y-8 order-1 lg:order-2">
				<h2 class="text-4xl font-bold leading-tight">
					¿Tu sitio es lento? <br />¿Te han hackeado?
				</h2>
				<p class="text-xl text-on-surface-variant">
					Si tu web no vende o experimentas caídas constantes, estás
					perdiendo dinero y reputación cada minuto. <strong
						>Nosotros lo solucionamos.</strong
					>
				</p>
				<div class="grid gap-4">
					<div
						class="flex items-center gap-4 p-4 bg-surface-container rounded-lg border-l-4 border-error"
					>
						<span class="material-symbols-outlined text-error"
							>report</span
						>
						<span class="font-medium italic"
							>"Me hackearon el WordPress y perdí acceso"</span
						>
					</div>
					<div
						class="flex items-center gap-4 p-4 bg-surface-container rounded-lg border-l-4 border-primary-container"
					>
						<span
							class="material-symbols-outlined text-primary-container"
							>verified</span
						>
						<span class="font-medium"
							>Limpieza completa y blindaje en 24h.</span
						>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- Diferencial Section -->
	<section class="py-24 bg-surface">
		<div class="container mx-auto px-8 text-center max-w-4xl">
			<h2 class="text-4xl font-bold mb-6">
				No solo desarrollamos… <br />protegemos tu negocio desde el
				primer día
			</h2>
			<div class="flex flex-wrap justify-center gap-4 mt-12">
				<div
					class="px-6 py-3 bg-surface-container-high rounded-full flex items-center gap-3 border border-outline-variant/20"
				>
					<span
						class="material-symbols-outlined text-primary-container"
						>security</span
					>
					<span class="font-bold">Security First</span>
				</div>
				<div
					class="px-6 py-3 bg-surface-container-high rounded-full flex items-center gap-3 border border-outline-variant/20"
				>
					<span
						class="material-symbols-outlined text-primary-container"
						>bolt</span
					>
					<span class="font-bold">Optimization</span>
				</div>
				<div
					class="px-6 py-3 bg-surface-container-high rounded-full flex items-center gap-3 border border-outline-variant/20"
				>
					<span
						class="material-symbols-outlined text-primary-container"
						>support_agent</span
					>
					<span class="font-bold">24/7 Tactical Support</span>
				</div>
			</div>
		</div>
	</section>
	<!-- Servicios: Detailed Grid -->
	<section class="py-24 bg-surface-container-low" id="servicios">
		<div class="container mx-auto px-8">
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div
					class="p-10 bg-surface rounded-xl border border-outline-variant/10 hover:shadow-2xl transition-all"
				>
					<h4
						class="text-sm font-mono text-primary-container uppercase mb-4 tracking-widest"
					>
						Audit
					</h4>
					<h3 class="text-2xl font-bold mb-4">Security Audit</h3>
					<p class="text-on-surface-variant mb-6 text-sm">
						Escaneo profundo de vulnerabilidades, inyecciones de
						código y debilidades estructurales.
					</p>
					<button
						class="text-primary-container flex items-center gap-2 text-sm font-bold group"
					>
						Saber más <span
							class="material-symbols-outlined group-hover:translate-x-2 transition-transform"
							>arrow_forward</span
						>
					</button>
				</div>
				<div
					class="p-10 bg-surface rounded-xl border border-outline-variant/10 hover:shadow-2xl transition-all"
				>
					<h4
						class="text-sm font-mono text-primary-container uppercase mb-4 tracking-widest"
					>
						Build
					</h4>
					<h3 class="text-2xl font-bold mb-4">Web Development</h3>
					<p class="text-on-surface-variant mb-6 text-sm">
						Desarrollo ágil orientado a conversión y seguridad desde
						el código base.
					</p>
					<button
						class="text-primary-container flex items-center gap-2 text-sm font-bold group"
					>
						Saber más <span
							class="material-symbols-outlined group-hover:translate-x-2 transition-transform"
							>arrow_forward</span
						>
					</button>
				</div>
				<div
					class="p-10 bg-surface rounded-xl border border-outline-variant/10 hover:shadow-2xl transition-all"
				>
					<h4
						class="text-sm font-mono text-primary-container uppercase mb-4 tracking-widest"
					>
						Speed
					</h4>
					<h3 class="text-2xl font-bold mb-4">Speed Optimization</h3>
					<p class="text-on-surface-variant mb-6 text-sm">
						Llevamos tu Core Web Vitals al 100%. Velocidad que
						impacta en el SEO.
					</p>
					<button
						class="text-primary-container flex items-center gap-2 text-sm font-bold group"
					>
						Saber más <span
							class="material-symbols-outlined group-hover:translate-x-2 transition-transform"
							>arrow_forward</span
						>
					</button>
				</div>
				<div
					class="p-10 bg-surface rounded-xl border border-outline-variant/10 hover:shadow-2xl transition-all"
				>
					<h4
						class="text-sm font-mono text-primary-container uppercase mb-4 tracking-widest"
					>
						Care
					</h4>
					<h3 class="text-2xl font-bold mb-4">Maintenance</h3>
					<p class="text-on-surface-variant mb-6 text-sm">
						Actualizaciones proactivas, backups diarios y monitoreo
						constante de uptime.
					</p>
					<button
						class="text-primary-container flex items-center gap-2 text-sm font-bold group"
					>
						Saber más <span
							class="material-symbols-outlined group-hover:translate-x-2 transition-transform"
							>arrow_forward</span
						>
					</button>
				</div>
				<div
					class="p-10 bg-surface rounded-xl border border-outline-variant/10 hover:shadow-2xl transition-all lg:col-span-2"
				>
					<div
						class="flex flex-col md:flex-row gap-8 h-full items-center"
					>
						<div class="flex-1">
							<h4
								class="text-sm font-mono text-primary-container uppercase mb-4 tracking-widest"
							>
								Infra
							</h4>
							<h3 class="text-2xl font-bold mb-4">
								Server Configuration
							</h3>
							<p class="text-on-surface-variant mb-6 text-sm">
								Configuramos y blindamos tu hosting, VPS o
								servidor dedicado para máximo rendimiento y
								aislamiento.
							</p>
							<button
								class="text-primary-container flex items-center gap-2 text-sm font-bold group"
							>
								Consultar ahora <span
									class="material-symbols-outlined group-hover:translate-x-2 transition-transform"
									>arrow_forward</span
								>
							</button>
						</div>
						<div
							class="w-full md:w-64 h-40 bg-surface-container-high rounded-lg flex items-center justify-center border border-outline-variant/20"
						>
							<span
								class="material-symbols-outlined text-6xl text-primary-container/30"
								>dns</span
							>
						</div>
					</div>
				</div>
			</div>
		</div>
