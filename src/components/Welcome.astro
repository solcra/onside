	<!-- Cómo trabajamos: Step Flow -->
	<section class="py-24 bg-surface" id="como-trabajamos">
		<div class="container mx-auto px-8">
			<div class="text-center mb-16">
				<h2 class="text-4xl font-bold mb-4">Cómo trabajamos</h2>
				<p class="text-on-surface-variant">
					Nuestro protocolo táctico paso a paso
				</p>
			</div>
			<div class="relative">
				<!-- Progress Line -->
				<div
					class="absolute top-1/2 left-0 w-full h-0.5 bg-surface-container-highest hidden md:block -translate-y-1/2"
				>
				</div>
				<div class="grid md:grid-cols-4 gap-8 relative z-10">
					<!-- Step 1 -->
					<div class="bg-surface p-6 text-center group">
						<div
							class="w-16 h-16 bg-surface-container mx-auto rounded-full flex items-center justify-center border-2 border-primary-container mb-6 group-hover:bg-primary-container group-hover:text-on-primary-container transition-all"
						>
							<span class="text-xl font-bold">01</span>
						</div>
						<h3 class="text-xl font-bold mb-2">Análisis</h3>
						<p class="text-sm text-on-surface-variant">
							Diagnosticamos tu situación actual y detectamos
							brechas.
						</p>
					</div>
					<!-- Step 2 -->
					<div class="bg-surface p-6 text-center group">
						<div
							class="w-16 h-16 bg-surface-container mx-auto rounded-full flex items-center justify-center border-2 border-primary-container mb-6 group-hover:bg-primary-container group-hover:text-on-primary-container transition-all"
						>
							<span class="text-xl font-bold">02</span>
						</div>
						<h3 class="text-xl font-bold mb-2">Implementación</h3>
						<p class="text-sm text-on-surface-variant">
							Desarrollamos o corregimos con estándares de alta
							calidad.
						</p>
					</div>
					<!-- Step 3 -->
					<div class="bg-surface p-6 text-center group">
						<div
							class="w-16 h-16 bg-surface-container mx-auto rounded-full flex items-center justify-center border-2 border-primary-container mb-6 group-hover:bg-primary-container group-hover:text-on-primary-container transition-all"
						>
