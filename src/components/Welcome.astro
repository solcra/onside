<!-- TopNavBar -->
<nav
	class="fixed top-0 w-full z-50 flex justify-between items-center px-8 h-20 max-w-full mx-auto glass-nav bg-surface/80"
>
	<div class="flex items-center gap-3">
		<img
			class="h-10 w-auto"
			data-alt="Onside professional logo, minimalist technical precision aesthetic in brand red"
			src="https://lh3.googleusercontent.com/aida-public/AB6AXuCLQEVHQYS7LTVc7vlMPxd8oPz2BsSLpkvsmyIM45j4Wre4O1PrIKpIOTM25BT6VH-LrFUNN6K5gK-LzMPrwGK3pproUD8RJt-oZR2HhVosl5EU1DRDLX0d18WrKDAh6QLGNrv1dTWk5GibunT0CZHlu08g4fN1npifoOKiA9BuJX4vTXeWdoNoOX3pXNfWMoithDkD6IIejgN6PR36rbLahJnOwAST0Hzz4JY7Nz0_rn8pJIOCWmm9UqHl186lVlxx0LozkyW4XA"
		/>
		<span class="text-2xl font-bold tracking-tighter text-[#e31b23]"
			>Onside</span
		>
	</div>
	<div
		class="hidden md:flex items-center gap-10 font-['Space_Grotesk'] text-sm tracking-tight"
	>
		<a
			class="text-[#e31b23] border-b-2 border-[#e31b23] pb-1"
			href="#que-hacemos">¿Qué hacemos?</a
		>
		<a
			class="text-stone-600 hover:text-[#e31b23] transition-colors duration-200"
			href="#servicios">Servicios</a
		>
		<a
			class="text-stone-600 hover:text-[#e31b23] transition-colors duration-200"
			href="#como-trabajamos">Cómo trabajamos</a
		>
	</div>
	<div class="flex items-center gap-4">
		<a
			class="hidden sm:block text-[#e31b23] font-medium text-sm hover:opacity-80 transition-opacity"
			href="#">WhatsApp</a
		>
		<button
			class="bg-[#e31b23] text-on-primary-container px-6 py-2.5 text-sm font-bold tracking-tight rounded-md hover:scale-95 duration-150 active:scale-90 shadow-lg shadow-primary/20"
		>
			Solicitar auditoría
		</button>
	</div>
</nav>
<main class="pt-20">
	<!-- HERO SECTION -->
	<section
		class="relative min-h-[921px] flex items-center overflow-hidden grid-pattern"
	>
		<div
			class="absolute inset-0 bg-gradient-to-br from-surface to-transparent pointer-events-none"
		>
		</div>
		<div
			class="container mx-auto px-8 relative z-10 flex flex-col md:flex-row gap-12 items-center"
		>
			<div class="w-full md:w-3/5">
				<div
					class="inline-block px-3 py-1 mb-6 bg-surface-container-high rounded-sm text-[10px] font-bold uppercase tracking-widest text-primary"
				>
					Infraestructura &amp; Seguridad
				</div>
				<h1
					class="text-5xl md:text-7xl font-bold tracking-tighter text-on-surface leading-[0.9] mb-8"
				>
					Soluciones tecnológicas <span class="text-primary"
						>seguras</span
					> para tu negocio.
				</h1>
				<p
					class="text-lg md:text-xl text-on-surface-variant max-w-xl leading-relaxed mb-10 font-light"
				>
					Desarrollamos, protegemos y optimizamos tu infraestructura
					digital con precisión técnica y rigor editorial.
				</p>
				<div class="flex flex-wrap gap-4">
					<button
						class="bg-gradient-to-br from-[#b90014] to-[#e31b23] text-white px-8 py-4 rounded-md font-bold text-sm tracking-tight hover:shadow-xl transition-all"
					>
						Solicitar auditoría
					</button>
					<button
						class="border-2 border-outline-variant text-on-surface px-8 py-4 rounded-md font-bold text-sm tracking-tight hover:bg-surface-container-low transition-colors"
					>
						Hablar por WhatsApp
					</button>
				</div>
			</div>
			<div class="w-full md:w-2/5 relative">
				<div
					class="aspect-square bg-surface-container-highest rounded-xl overflow-hidden relative shadow-2xl"
				>
					<img
						class="object-cover w-full h-full opacity-90 mix-blend-multiply"
						data-alt="Close-up of a high-end server rack with subtle red LED lights in a clean, modern data center environment"
						src="https://lh3.googleusercontent.com/aida-public/AB6AXuChT-Ft7NnGDKhtL_UZXdnb_bqWp5JkieJzb0uyCuMdkQ3aJg6vFAz4RnlFBdQb64_zJxe8au21K-9Iv2A_OpOdm3_7Kszp_qmtBP10oBUQ24pu-j1tAK6Ha71bKB_Qkdg4q1GC9DsH3ciMPldP-y714GMAuTlbs2bigphaTVf7ElbIwMiuciIXXRgjCxkoZm8l7TQJfiWtGYrDJJijhGYiedPQHuLkxTEu99RlY8gIPF7VSZh3HZx_7mACMvWj-55LAyawPqEhfg"
					/>
					<div
						class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent"
					>
					</div>
				</div>
				<!-- Decorative Floating Element -->
				<div
					class="absolute -bottom-6 -left-6 bg-white p-6 shadow-xl rounded-lg max-w-[200px] border-l-4 border-primary"
				>
					<span
						class="block text-[10px] font-bold text-outline tracking-widest uppercase mb-1"
						>System Status</span
					>
					<div class="flex items-center gap-2">
						<div class="w-2 h-2 rounded-full bg-green-500"></div>
						<span
							class="text-xs font-mono font-bold tracking-tighter"
							>SECURE &amp; OPTIMIZED</span
						>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- ¿Qué hacemos? Section -->
	<section class="py-24 bg-surface" id="que-hacemos">
		<div class="container mx-auto px-8">
			<div
				class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8"
			>
				<div class="max-w-2xl">
					<h2
						class="text-4xl font-bold tracking-tighter leading-tight"
					>
						¿Qué hacemos?
					</h2>
					<p class="mt-4 text-on-surface-variant font-light">
						Transformamos la complejidad técnica en ventaja
						competitiva.
					</p>
				</div>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
				<!-- Block 1: Seguridad -->
				<div class="group">
					<div
						class="w-14 h-14 bg-surface-container-high rounded-lg flex items-center justify-center mb-8 group-hover:bg-primary-container group-hover:text-white transition-colors duration-300"
					>
						<span
							class="material-symbols-outlined text-3xl"
							data-icon="shield_lock"
							style="font-variation-settings: 'FILL' 0;"
							>shield_lock</span
						>
					</div>
					<h3 class="text-2xl font-bold tracking-tight mb-4">
						Seguridad
					</h3>
					<ul class="space-y-3 text-on-surface-variant font-light">
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> Auditorías profundas
						</li>
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> Protección WordPress
						</li>
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> Prevención de ataques
						</li>
					</ul>
				</div>
				<!-- Block 2: Desarrollo Web -->
				<div class="group">
					<div
						class="w-14 h-14 bg-surface-container-high rounded-lg flex items-center justify-center mb-8 group-hover:bg-primary-container group-hover:text-white transition-colors duration-300"
					>
						<span
							class="material-symbols-outlined text-3xl"
							data-icon="web"
							style="font-variation-settings: 'FILL' 0;">web</span
						>
					</div>
					<h3 class="text-2xl font-bold tracking-tight mb-4">
						Desarrollo web
					</h3>
					<ul class="space-y-3 text-on-surface-variant font-light">
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> Sitios de alto rendimiento
						</li>
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> WordPress &amp; E-commerce
						</li>
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> UX técnica optimizada
						</li>
					</ul>
				</div>
				<!-- Block 3: Backend -->
				<div class="group">
					<div
						class="w-14 h-14 bg-surface-container-high rounded-lg flex items-center justify-center mb-8 group-hover:bg-primary-container group-hover:text-white transition-colors duration-300"
					>
						<span
							class="material-symbols-outlined text-3xl"
							data-icon="database"
							style="font-variation-settings: 'FILL' 0;"
							>database</span
						>
					</div>
					<h3 class="text-2xl font-bold tracking-tight mb-4">
						Backend
					</h3>
					<ul class="space-y-3 text-on-surface-variant font-light">
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> APIs robustas
						</li>
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> Integraciones complejas
						</li>
						<li class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 bg-primary rounded-full"
							></span> Sistemas a medida
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	<!-- Problem/Solution Section -->
	<section class="py-24 bg-surface-container-low">
		<div class="container mx-auto px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
				<div>
					<h2
						class="text-4xl font-bold tracking-tighter leading-[1.1] mb-8"
					>
						¿Tu sitio es lento? ¿Te han hackeado? ¿Tu web no vende?
					</h2>
					<p
						class="text-xl text-primary font-bold tracking-tight mb-8"
					>
						Nosotros lo solucionamos.
					</p>
					<div class="space-y-6">
						<div
							class="flex gap-4 p-4 bg-surface rounded-xl shadow-sm border-l-2 border-primary"
						>
							<span
								class="material-symbols-outlined text-primary"
								data-icon="speed">speed</span
							>
							<div>
								<h4 class="font-bold text-sm">
									Optimización de Velocidad
								</h4>
								<p class="text-xs text-on-surface-variant mt-1">
									Reducimos los tiempos de carga al mínimo
									absoluto.
								</p>
							</div>
						</div>
						<div
							class="flex gap-4 p-4 bg-surface rounded-xl shadow-sm border-l-2 border-primary"
						>
							<span
								class="material-symbols-outlined text-primary"
								data-icon="gpp_good">gpp_good</span
							>
							<div>
								<h4 class="font-bold text-sm">
									Recuperación &amp; Blindaje
								</h4>
								<p class="text-xs text-on-surface-variant mt-1">
									Limpieza de malware y fortalecimiento de
									perímetros.
								</p>
							</div>
						</div>
					</div>
				</div>
				<div class="relative">
					<div
						class="aspect-video bg-surface-container-highest rounded-2xl overflow-hidden shadow-2xl rotate-2"
					>
						<img
							class="w-full h-full object-cover"
							data-alt="Technical dashboard showing clean data visualization and security metrics in a high-tech interface"
							src="https://lh3.googleusercontent.com/aida-public/AB6AXuC7AzydmNINvxIVaYNZkfSZLj7cSTz-GeRlhD8CXwxI-eC7t7CnH8RSHEDxjhwlAv1CK0_3ZRGMmmUCplRJT2fHdiKOuXbF_A-jTMP2jBdKXTk9nqlhqP66hbC_CLQuTlgeXds62m5yzQpbA0mBlvCRAfqLXl9BhUVWTJJPruvNn0DCaH7zsnkogfHNs3oQAj2FTTGIj7lXxEDQx_SJBl-r1MEiAj4cvUqBilhiWuWH1wEq398N7Vykx8jxWGWh3pWVxc3_C-ROEg"
						/>
					</div>
					<div
						class="absolute -top-8 -right-8 w-32 h-32 bg-primary-container rounded-full flex items-center justify-center text-white font-bold text-center leading-none -rotate-12 shadow-xl border-4 border-surface"
					>
						SOLUCIÓN<br />DIRECTA
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- Differential Section -->
	<section class="py-32 bg-surface">
		<div class="container mx-auto px-8 text-center max-w-4xl">
			<h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-10">
				No solo desarrollamos… <span class="text-primary"
					>protegemos tu negocio</span
				> desde el primer día.
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-20">
				<div class="p-8 bg-surface-container-lowest rounded-2xl">
					<div class="text-primary mb-4 font-black text-4xl">01</div>
					<h4 class="font-bold mb-2">Seguridad integrada</h4>
					<p class="text-sm text-on-surface-variant leading-relaxed">
						El código nace seguro. No es un añadido posterior.
					</p>
				</div>
				<div class="p-8 bg-surface-container-lowest rounded-2xl">
					<div class="text-primary mb-4 font-black text-4xl">02</div>
					<h4 class="font-bold mb-2">Optimización real</h4>
					<p class="text-sm text-on-surface-variant leading-relaxed">
						Infraestructura diseñada para escalar sin fricción.
					</p>
				</div>
				<div class="p-8 bg-surface-container-lowest rounded-2xl">
					<div class="text-primary mb-4 font-black text-4xl">03</div>
					<h4 class="font-bold mb-2">Soporte técnico</h4>
					<p class="text-sm text-on-surface-variant leading-relaxed">
						Ingenieros reales, respuestas inmediatas y precisas.
					</p>
				</div>
			</div>
		</div>
	</section>
	<!-- Detailed Services (Bento Grid) -->
	<section class="py-24 bg-surface-container-low" id="servicios">
		<div class="container mx-auto px-8">
			<h2 class="text-3xl font-bold tracking-tighter mb-12">
				Nuestros Servicios de Precisión
			</h2>
			<div
				class="grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 h-auto md:h-[600px]"
			>
				<div
					class="md:col-span-2 md:row-span-2 bg-surface rounded-3xl p-10 flex flex-col justify-between shadow-sm group hover:shadow-md transition-shadow"
				>
					<div>
						<span
							class="label-sm px-3 py-1 bg-surface-container-highest rounded text-primary font-bold"
							>Security Audit</span
						>
						<h3 class="text-3xl font-bold mt-6 mb-4">
							Auditoría de Seguridad
						</h3>
						<p
							class="text-on-surface-variant leading-relaxed max-w-sm"
						>
							Evaluamos cada vector de ataque potencial en tu
							infraestructura actual para blindar tus activos
							digitales.
						</p>
					</div>
					<div class="mt-8">
						<img
							class="rounded-xl h-40 w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
							data-alt="Close up of high-tech digital code and encrypted security layers on a dark screen"
							src="https://lh3.googleusercontent.com/aida-public/AB6AXuDZlozXPaApGKaQZEC3moTahsL_AxdXX4NWxaMmQy39ptMfFjhmOoJu-r7URH6TII_pQVqmd2lrLpF3m4T5Ztskseg3epk4YyO0A149b1YG_CFxKMlXYRvNKIwvAIBzqCXnrfrRT3CFFPQ2nKViRMpEOoiC6MIobYgzw4wTO3EGp5XhmvVYb-24xrr93Cs5YtH67qJQEyAKOHc2PlRgE1Wozpazy8gy-0o5ULUkb_6GJpBu_gf9R6UNtDjDErR0BpGblM1EFvTrKw"
						/>
					</div>
				</div>
				<div
					class="md:col-span-2 bg-surface rounded-3xl p-8 flex gap-6 items-center shadow-sm"
				>
					<div class="w-1/2">
						<h3 class="text-xl font-bold mb-2">Web Dev</h3>
						<p
							class="text-xs text-on-surface-variant leading-relaxed"
						>
							Desarrollo robusto con enfoque en conversión y
							velocidad extrema.
						</p>
					</div>
					<div class="w-1/2 h-full">
						<img
							class="rounded-xl h-full w-full object-cover"
							data-alt="Developer workspace with multiple monitors showing clean modern web design prototypes"
							src="https://lh3.googleusercontent.com/aida-public/AB6AXuCML4FrUi9p_eeJZJcTMN60CH9QIFiDh_q8gq_3M-hxNcXxzDyAJB-9Sj8tb6z4zWTGeKUImy-BR8erdwPbx4JrS1yCN-_KP1jhp7j7NDM4M8GCUD68v9__KviWpsGoImCqwdzW14d1fojCZPWcYIVWwRm_evxL7k3JQkEl4e3DTbm1eSrhXN9BspP8NYet1c1dF2Q-yVl-SLDkWUIkVz118e6plKM9fO0DEl1RLu64UsP2zsRRVhGFacxnKiWHeR_fRD11O7_FUA"
						/>
					</div>
				</div>
				<div
					class="bg-surface rounded-3xl p-6 flex flex-col justify-center shadow-sm"
				>
					<span
						class="material-symbols-outlined text-primary mb-3"
						data-icon="bolt">bolt</span
					>
					<h3 class="font-bold text-sm">Speed Optimization</h3>
				</div>
				<div
					class="bg-primary-container rounded-3xl p-6 flex flex-col justify-center shadow-sm text-white"
				>
					<span
						class="material-symbols-outlined mb-3"
						data-icon="settings"
						style="font-variation-settings: 'FILL' 1;"
						>settings</span
					>
					<h3 class="font-bold text-sm">Maintenance</h3>
				</div>
				<div
					class="md:col-span-2 bg-surface rounded-3xl p-8 shadow-sm flex items-center justify-between"
				>
					<div>
						<h3 class="font-bold text-xl mb-1">Server Config</h3>
						<p class="text-xs text-on-surface-variant">
							Arquitectura Cloud &amp; On-Premise optimizada.
						</p>
					</div>
					<span
						class="material-symbols-outlined text-primary text-4xl"
						data-icon="dns">dns</span
					>
				</div>
			</div>
		</div>
	</section>
	<!-- Process Section -->
	<section class="py-24 bg-surface" id="como-trabajamos">
		<div class="container mx-auto px-8">
			<h2 class="text-center text-4xl font-bold tracking-tighter mb-20">
				Metodología de Implementación
			</h2>
			<div class="relative flex flex-col md:flex-row gap-0">
				<!-- Line decoration -->
				<div
					class="hidden md:block absolute top-12 left-0 w-full h-px bg-outline-variant/30 z-0"
				>
				</div>
				<div class="relative z-10 flex-1 px-4 mb-12 md:mb-0">
					<div
						class="w-24 h-24 bg-surface border-4 border-surface-container-high rounded-full flex items-center justify-center text-3xl font-black text-primary mb-6 mx-auto md:mx-0"
					>
						01
					</div>
					<h4 class="font-bold text-xl mb-3 text-center md:text-left">
						Análisis
					</h4>
					<p
						class="text-sm text-on-surface-variant leading-relaxed text-center md:text-left"
					>
						Escaneamos y diagnosticamos el estado actual de tu
						tecnología.
					</p>
				</div>
				<div class="relative z-10 flex-1 px-4 mb-12 md:mb-0">
					<div
						class="w-24 h-24 bg-surface border-4 border-surface-container-high rounded-full flex items-center justify-center text-3xl font-black text-primary mb-6 mx-auto md:mx-0"
					>
						02
					</div>
					<h4 class="font-bold text-xl mb-3 text-center md:text-left">
						Implementación
					</h4>
					<p
						class="text-sm text-on-surface-variant leading-relaxed text-center md:text-left"
					>
						Ejecutamos las mejoras y desarrollos bajo estándares de
						precisión.
					</p>
				</div>
				<div class="relative z-10 flex-1 px-4 mb-12 md:mb-0">
					<div
						class="w-24 h-24 bg-surface border-4 border-surface-container-high rounded-full flex items-center justify-center text-3xl font-black text-primary mb-6 mx-auto md:mx-0"
					>
						03
					</div>
					<h4 class="font-bold text-xl mb-3 text-center md:text-left">
						Protección
					</h4>
					<p
						class="text-sm text-on-surface-variant leading-relaxed text-center md:text-left"
					>
						Blindamos el sistema contra amenazas externas e
						internas.
					</p>
				</div>
				<div class="relative z-10 flex-1 px-4">
					<div
						class="w-24 h-24 bg-surface border-4 border-primary rounded-full flex items-center justify-center text-3xl font-black text-primary mb-6 mx-auto md:mx-0"
					>
						04
					</div>
					<h4 class="font-bold text-xl mb-3 text-center md:text-left">
						Optimización
					</h4>
					<p
						class="text-sm text-on-surface-variant leading-relaxed text-center md:text-left"
					>
						Ajuste fino continuo para garantizar el máximo
						rendimiento.
					</p>
				</div>
			</div>
		</div>
	</section>
	<!-- CTA Section -->
	<section class="py-24">
		<div class="container mx-auto px-8">
			<div
				class="bg-primary-container rounded-[2.5rem] p-12 md:p-24 text-center relative overflow-hidden shadow-2xl shadow-primary/30"
			>
				<div
					class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-32 -mt-32"
				>
