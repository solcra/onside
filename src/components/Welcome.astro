	</section>
	<!-- ¿Qué hacemos? Bento Grid -->
	<section class="py-24 bg-surface" id="que-hacemos">
		<div class="container mx-auto px-8">
			<div class="mb-16">
				<h2 class="text-4xl font-bold mb-4">¿Qué hacemos?</h2>
				<div class="h-1 w-20 bg-primary-container"></div>
			</div>
			<div class="grid md:grid-cols-3 gap-6">
				<!-- Card 1: Seguridad -->
				<div
					class="bg-surface-container rounded-xl p-8 border border-transparent hover:border-primary-container/30 transition-all group"
				>
					<div
						class="w-12 h-12 bg-primary-container/10 rounded-lg flex items-center justify-center mb-6 text-primary-container group-hover:scale-110 transition-transform"
					>
						<span class="material-symbols-outlined"
							>shield_lock</span
						>
					</div>
					<h3 class="text-2xl font-bold mb-4">Seguridad</h3>
					<ul class="space-y-3 text-on-surface-variant">
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> Auditorías profundas
						</li>
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> Protección WordPress avanzada
						</li>
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> Prevención de ataques (WAF)
						</li>
					</ul>
				</div>
				<!-- Card 2: Desarrollo -->
				<div
					class="bg-surface-container rounded-xl p-8 border border-transparent hover:border-primary-container/30 transition-all group"
				>
					<div
						class="w-12 h-12 bg-primary-container/10 rounded-lg flex items-center justify-center mb-6 text-primary-container group-hover:scale-110 transition-transform"
					>
						<span class="material-symbols-outlined">code</span>
					</div>
					<h3 class="text-2xl font-bold mb-4">Desarrollo web</h3>
					<ul class="space-y-3 text-on-surface-variant">
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> Sitios rápidos y ultra-seguros
						</li>
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> WordPress &amp; Headless CMS
						</li>
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> E-commerce de alto rendimiento
						</li>
					</ul>
				</div>
				<!-- Card 3: Backend -->
				<div
					class="bg-surface-container rounded-xl p-8 border border-transparent hover:border-primary-container/30 transition-all group"
				>
					<div
						class="w-12 h-12 bg-primary-container/10 rounded-lg flex items-center justify-center mb-6 text-primary-container group-hover:scale-110 transition-transform"
					>
						<span class="material-symbols-outlined">terminal</span>
					</div>
					<h3 class="text-2xl font-bold mb-4">
						Backend / automatización
					</h3>
					<ul class="space-y-3 text-on-surface-variant">
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> APIs robustas
						</li>
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> Integraciones de terceros
						</li>
						<li class="flex items-center gap-2">
							<span
								class="w-1.5 h-1.5 bg-primary-container rounded-full"
							></span> Sistemas a medida
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	<!-- Problemas & Soluciones: Asymmetric Layout -->
	<section class="py-24 bg-surface-container-low relative">
		<div
			class="container mx-auto px-8 grid lg:grid-cols-2 gap-16 items-center"
		>
			<div class="relative order-2 lg:order-1">
				<img
					class="rounded-2xl w-full shadow-2xl grayscale hover:grayscale-0 transition-all duration-700"
					data-alt="close-up of server racks with neon green fiber optic cables in a dimly lit data center, cinematic technical atmosphere"
					src="https://lh3.googleusercontent.com/aida-public/AB6AXuC5qQjmT5BmRSkQWYvhhEqXFNL129coDaDR7EUBLn2mZwqPrHgluCdLFPoN_fIvaHdKl7RKgVkcr2TtkdtxqVWWroq7sXvjG0Bbfw4NzEk8xuPexc1eAx9b3e6kIR3PxgowsNHi3G7DFlTdFPkbLRleyq0JIQQ4RFfXSrj7WWEc7aSBEU85Rauz7re1ySyCxY6lJqYwrbQsm1433YEvxp7OQvhwJR7IIiBbjFSykUMAclT0Nn2MrynRmZEWhzCNY3SuP2V9omm5_g"
				/>
