---
import Layout from "../layouts/Layout.astro";
import logoEntintados from "../assets/entintados.png";
import logoServital from "../assets/servital.png";
import logoSustainable from "../assets/sustainable.png";
---

<Layout
	title="Nuestros Clientes | Rolaps"
	titleSeo="Nuestros Clientes | Rolaps"
	descripcionSeo="Conoce a las empresas que confían en nuestra precisión técnica para asegurar su infraestructura y potenciar su evolución digital."
>
	<!-- Hero Section -->
	<header class="relative pt-48 pb-24 px-8 overflow-hidden">
		<div class="absolute inset-0 code-pattern pointer-events-none"></div>
		<div class="max-w-7xl mx-auto relative z-10">
			<div
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high border border-outline-variant/30 mb-6"
			>
				<span
					class="w-2 h-2 rounded-full bg-primary-container animate-pulse"
				></span>
				<span
					class="text-xs font-headline uppercase tracking-widest text-primary-fixed font-semibold"
					>Network Trust</span
				>
			</div>
			<h1
				class="text-5xl md:text-7xl font-display font-bold text-on-surface mb-8 tracking-tighter leading-[1.1]"
			>
				Nuestros <span class="text-primary-container">Clientes</span>
			</h1>
			<p
				class="text-xl md:text-2xl text-on-surface-variant max-w-2xl font-light leading-relaxed"
			>
				Empresas que confían en nuestra precisión técnica para asegurar
				su infraestructura y potenciar su evolución digital.
			</p>
		</div>
	</header>

	<!-- Main Client Grid -->
	<main class="px-8 pb-32">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				<!-- Client 1: Entintados -->
				<article
					class="glass-card p-10 flex flex-col group h-full rounded-xl"
				>
					<div
						class="h-24 flex items-center mb-8 grayscale group-hover:grayscale-0 transition-all duration-500"
					>
						<img
							alt="Logo Entintados"
							class="max-h-full max-w-full object-contain"
							src={logoEntintados.src}
						/>
					</div>
					<div class="flex-grow">
						<h3
							class="text-2xl font-headline font-bold text-on-surface mb-4"
						>
							Entintados
						</h3>
						<p class="text-on-surface-variant mb-6 leading-relaxed">
							Líderes en producción gráfica e impresión a gran
							escala. Su operatividad depende de una
							sincronización perfecta entre diseño y hardware
							industrial.
						</p>
						<div class="pt-6 border-t border-outline-variant/10">
							<span
								class="text-xs font-headline uppercase tracking-widest text-primary-container/70 mb-3 block"
								>Solución Onside</span
							>
							<p
								class="text-on-surface text-sm font-medium leading-relaxed"
							>
								Implementación de una infraestructura de red
								robusta y optimización de sistemas de flujo de
								trabajo para garantizar latencia cero en
								transferencia de archivos pesados.
							</p>
						</div>
					</div>
					<div
						class="mt-10 flex items-center gap-2 text-primary-container font-headline text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity"
					>
						VER CASO DE ESTUDIO <span
							class="material-symbols-outlined text-sm"
							>arrow_forward</span
						>
					</div>
				</article>

				<!-- Client 2: Organización Servital -->
				<article
					class="glass-card p-10 flex flex-col group h-full rounded-xl"
				>
					<div
						class="h-24 flex items-center mb-8 grayscale group-hover:grayscale-0 transition-all duration-500"
					>
						<img
							alt="Logo Organización Servital"
							class="max-h-full max-w-full object-contain"
							src={logoServital.src}
						/>
					</div>
					<div class="flex-grow">
						<h3
							class="text-2xl font-headline font-bold text-on-surface mb-4"
						>
							Organización Servital
						</h3>
						<p class="text-on-surface-variant mb-6 leading-relaxed">
							Institución referente en medicina holística y salud
							integral. Gestionan datos sensibles que requieren
							los más altos estándares de privacidad.
						</p>
						<div class="pt-6 border-t border-outline-variant/10">
							<span
								class="text-xs font-headline uppercase tracking-widest text-primary-container/70 mb-3 block"
								>Solución Onside</span
							>
							<p
								class="text-on-surface text-sm font-medium leading-relaxed"
							>
								Auditoría de ciberseguridad profunda y
								despliegue de sistemas de encriptación de grado
								médico para el resguardo de historiales clínicos
								digitales.
							</p>
						</div>
					</div>
					<div
						class="mt-10 flex items-center gap-2 text-primary-container font-headline text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity"
					>
						VER CASO DE ESTUDIO <span
							class="material-symbols-outlined text-sm"
							>arrow_forward</span
						>
					</div>
				</article>

				<!-- Client 3: Soya Sostenible US -->
				<article
					class="glass-card p-10 flex flex-col group h-full rounded-xl"
				>
					<div
						class="h-24 flex items-center mb-8 grayscale group-hover:grayscale-0 transition-all duration-500"
					>
						<img
							alt="Logo Soya Sostenible US"
							class="max-h-full max-w-full object-contain"
							src={logoSustainable.src}
						/>
					</div>
					<div class="flex-grow">
						<h3
							class="text-2xl font-headline font-bold text-on-surface mb-4"
						>
							Soya Sostenible US
						</h3>
						<p class="text-on-surface-variant mb-6 leading-relaxed">
							Organización internacional dedicada a la agricultura
							sostenible y el cumplimiento de normativas globales
							para la exportación de granos.
						</p>
						<div class="pt-6 border-t border-outline-variant/10">
							<span
								class="text-xs font-headline uppercase tracking-widest text-primary-container/70 mb-3 block"
								>Solución Onside</span
							>
							<p
								class="text-on-surface text-sm font-medium leading-relaxed"
							>
								Transformación digital completa mediante la
								creación de plataformas de trazabilidad basadas
								en datos para cumplir con estándares
								internacionales.
							</p>
						</div>
					</div>
					<div
						class="mt-10 flex items-center gap-2 text-primary-container font-headline text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity"
					>
						VER CASO DE ESTUDIO <span
							class="material-symbols-outlined text-sm"
							>arrow_forward</span
						>
					</div>
				</article>
			</div>
		</div>
	</main>

	<!-- Success CTA Section -->
	<section class="bg-surface-container py-24 px-8 relative overflow-hidden">
		<div class="max-w-4xl mx-auto text-center relative z-10">
			<h2
				class="text-3xl md:text-5xl font-display font-bold mb-8 leading-tight"
			>
				¿Listo para ser nuestro próximo <span
					class="text-primary-container italic">caso de éxito</span
				>?
			</h2>
			<p
				class="text-lg text-on-surface-variant mb-12 max-w-2xl mx-auto font-light"
			>
				Diseñamos soluciones tácticas a medida. Eleva la seguridad y
				eficiencia de tu infraestructura con el equipo de Onside.
			</p>
			<div
				class="flex flex-col sm:flex-row items-center justify-center gap-6"
			>
				<button
					class="px-10 py-4 bg-primary-container text-on-primary-container rounded-full font-bold text-lg hover:scale-105 transition-transform btn-solicitar-auditoria"
				>
					Contáctanos ahora
				</button>
				<a
					class="group flex items-center gap-2 text-on-surface font-headline font-medium hover:text-primary-container transition-colors"
					href="/#servicios"
				>
					Revisar todos los servicios <span
						class="material-symbols-outlined">trending_flat</span
					>
				</a>
			</div>
		</div>
		<!-- Decorative subtle grid -->
		<div
			class="absolute inset-0 opacity-10 pointer-events-none"
			style="background-image: linear-gradient(#3f465c 1px, transparent 1px), linear-gradient(90deg, #3f465c 1px, transparent 1px); background-size: 80px 80px;"
		>
		</div>
	</section>

	<style>
		.glass-card {
			background: rgba(25, 31, 49, 0.6);
			backdrop-filter: blur(12px);
			border-bottom: 2px solid #2e3447;
			transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		}
		.glass-card:hover {
			border-bottom-color: #00ff41;
			transform: translateY(-4px);
			background: rgba(35, 41, 60, 0.8);
		}
		.code-pattern {
			background-image: radial-gradient(#00ff41 0.5px, transparent 0.5px);
			background-size: 24px 24px;
			opacity: 0.05;
		}
	</style>

	<script>
		// Micro-interactions for scroll revealing
		document.addEventListener("DOMContentLoaded", () => {
			const cards = document.querySelectorAll(".glass-card");
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.remove(
								"opacity-0",
								"translate-y-10",
							);
						}
					});
				},
				{ threshold: 0.1 },
			);

			cards.forEach((card) => {
				card.classList.add(
					"opacity-0",
					"translate-y-10",
					"transition-all",
					"duration-700",
				);
				observer.observe(card);
			});
		});
	</script>
</Layout>
